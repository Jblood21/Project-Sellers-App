# Server
PORT=3000
NODE_ENV=development

# Postgres (Render provides this). Omit locally to use the JSON file store.
DATABASE_URL=

# Admin bootstrap — the first admin account is created on boot when these are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Secret used to sign admin session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared secret for the inbound rates webhook (Zapier -> POST /api/communities/:id/rates)
RATES_WEBHOOK_SECRET=

# Public origin used when generating QR links (defaults to the request host)
PUBLIC_ORIGIN=
