# Server
PORT=3000
NODE_ENV=development

# Postgres (Render provides this). Omit locally to use the JSON file store.
DATABASE_URL=

# Admin bootstrap — the first admin account is created on boot when these are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Secret used to sign admin session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared secret for the inbound rates webhook (Zapier -> POST /api/communities/:id/rates)
RATES_WEBHOOK_SECRET=

# The one public address of the site, with the https://, e.g. https://touradoor.com.
# Set this in production. It is the origin written into each page's canonical link,
# Open Graph tags and structured data, and into the links in emails. Unset, the
# request's own Host decides, so a site that answers on two names would publish two
# canonicals. A value without https:// is ignored (the server says so at boot).
PUBLIC_ORIGIN=

# Outbound email (Resend). Without RESEND_API_KEY the app simply does not send:
# nothing breaks, call requests are still recorded, buyers can still take the PDF.
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend, and one somebody
# reads: buyers reply to their plan email, and a no-reply address drops those.
# Unset, mail goes from onboarding@resend.dev, which only reaches the Resend account owner.
EMAIL_FROM=Touradoor <hello@yourdomain.com>

# Set to false to start a fresh database empty instead of with a demo community.
SEED_DEMO=
