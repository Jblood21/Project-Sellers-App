# Server
PORT=3000
NODE_ENV=development

# Postgres (Render provides this). Omit locally to use the JSON file store.
DATABASE_URL=

# Admin bootstrap — the first admin account is created on boot when these are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Secret used to sign admin session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Shared secret for the inbound rates webhook (Zapier -> POST /api/communities/:id/rates)
RATES_WEBHOOK_SECRET=

# Public origin used when generating QR links (defaults to the request host)
PUBLIC_ORIGIN=

# Outbound email (Resend). Without RESEND_API_KEY the app simply does not send:
# nothing breaks, call requests are still recorded, buyers can still take the PDF.
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
EMAIL_FROM=Cornerpost <no-reply@yourdomain.com>
